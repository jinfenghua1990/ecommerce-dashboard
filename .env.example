# ===== 基础 =====
# APP_SECRET_KEY 用于凭证加密，必须更换为随机长字符串
APP_SECRET_KEY=
ACCESS_MODE=rbac

# 运行 API / worker / beat 的非 root UID/GID。部署机上执行 `id -u`、`id -g` 后填入。
# macOS 常见为 501 / 20；Linux 常见为 1000 / 1000。
RUNTIME_UID=1000
RUNTIME_GID=1000

# 首次启动管理员；已有账号密码不会被环境变量覆盖，除非显式开启强制重置。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
FORCE_ADMIN_PASSWORD=0

# 容器内地址由 compose 注入，此处仅文档用途
DATABASE_URL=
REDIS_URL=

# ===== 吉客云 MCP（Phase 1）=====
JACKYUN_MCP_URL=
JACKYUN_APP_KEY=
JACKYUN_MCP_TOKEN=
JACKYUN_SYNC_MODE=manual

# ===== 吉客云销售订单三通道 =====
# 默认 Web → Windows RPA → OpenAPI/MCP；可写 web,rpa,api 调整顺序
JKY_ORDER_PROVIDER_PRIORITY=jky_web,jky_rpa,jky_api
JKY_ORDER_SYNC_INTERVAL_MINUTES=30
JKY_ORDER_SYNC_OVERLAP_MINUTES=30
JKY_ORDER_INITIAL_LOOKBACK_DAYS=3
JKY_ORDER_STALE_RUN_MINUTES=180
JKY_ORDER_LOW_COUNT_RATIO=0.25
# Windows RPA Agent（在 Windows 桌面机运行）；留空表示未配置
JKY_RPA_AGENT_URL=
JKY_RPA_AGENT_TOKEN=
JKY_RPA_TIMEOUT_SECONDS=900
JKY_RPA_HEALTH_TIMEOUT_SECONDS=5
JKY_API_MAX_RETRIES=2

# ===== 1688 开放平台（Phase 4，未提供前显示未配置）=====
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_REDIRECT_URI=

# ===== 财务邮件（Phase 6）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ===== Postgres 容器初始化 =====
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
