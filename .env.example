# ===== 基础 =====
# APP_SECRET_KEY 用于凭证加密，必须更换为随机长字符串
APP_SECRET_KEY=
ACCESS_MODE=lan_trusted

# 容器内地址由 compose 注入，此处仅文档用途
DATABASE_URL=
REDIS_URL=

# ===== 吉客云 MCP（Phase 1）=====
JACKYUN_MCP_URL=
JACKYUN_APP_KEY=
JACKYUN_MCP_TOKEN=

# ===== 1688 开放平台（Phase 4，未提供前显示未配置）=====
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_REDIRECT_URI=

# ===== 财务邮件（Phase 6）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ===== Postgres 容器初始化 =====
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
