        </div>
      </section>

      <section className="rounded-2xl border border-gray-200 bg-white p-4">
        <div className="flex items-start justify-between gap-3">
          <div>
            <h3 className="text-sm font-semibold text-gray-800">② 实际采购内容 / 吉客云 SKU</h3>
            <p className="mt-1 text-[11px] text-gray-400">1688 的“定制专拍”不会自动变成 SKU，必须落到吉客云主档</p>
          </div>
          {row.purchaseContentComplete ? (
            <span className="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-emerald-700">已完善</span>
          ) : (
            <Link href="/purchase" className="rounded-lg bg-indigo-600 px-2.5 py-1.5 text-[11px] font-medium text-white hover:bg-indigo-700">去完善</Link>
          )}
        </div>
        {row.allocations.length > 0 ? (
          <div className="mt-3 space-y-2">
            {row.allocations.map((item) => (
              <div key={item.id} className="flex items-center justify-between gap-3 rounded-xl bg-gray-50 px-3 py-2">
                <div className="min-w-0">
                  <div className="truncate text-xs font-medium text-gray-800">{item.goodsName || item.skuCode || "SKU"}</div>
                  <div className="mt-0.5 font-mono text-[10px] text-gray-400">{item.skuCode || "未填写编码"}</div>
                </div>
                <div className="shrink-0 text-right text-xs text-gray-600">
