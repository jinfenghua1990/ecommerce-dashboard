        )}
      </section>

      <div className="grid gap-4 sm:grid-cols-2">
        <section className="rounded-2xl border border-gray-200 bg-white p-4">
          <h3 className="text-sm font-semibold text-gray-800">④ 入库 · ⑤ 付款</h3>
          <div className="mt-3 space-y-3">
            <div>
              <div className="mb-1 text-[11px] text-gray-400">入库单</div>
              {row.inbound.length ? row.inbound.map((item) => (
                <div key={item.goodsdocNo} className="mb-1 rounded-lg bg-teal-50/60 px-3 py-2 text-xs">
                  <div className="font-mono font-medium text-gray-800">{item.goodsdocNo}</div>
                  <div className="mt-0.5 text-[10px] text-gray-500">{date(item.date)} · {item.warehouseName || "未填写仓库"}</div>
                </div>
              )) : <div className="rounded-lg bg-gray-50 px-3 py-2 text-xs text-gray-400">暂无已关联入库单</div>}
            </div>
            <div>
              <div className="mb-1 text-[11px] text-gray-400">采购结算</div>
              {row.settlement.length ? row.settlement.map((item) => (
                <div key={item.settlementNo} className={`mb-1 rounded-lg px-3 py-2 text-xs ${item.paid ? "bg-emerald-50" : "bg-amber-50"}`}>
                  <div className="flex items-center justify-between gap-2"><span className="font-mono font-medium text-gray-800">{item.settlementNo}</span><span className={item.paid ? "text-emerald-700" : "text-amber-700"}>{item.paid ? "已付款" : "未付款"}</span></div>
                  <div className="mt-0.5 flex justify-between text-[10px] text-gray-500"><span>{date(item.date)}</span><span>{money(item.paidAmount ?? item.amount)}</span></div>
                </div>
              )) : <div className="rounded-lg bg-gray-50 px-3 py-2 text-xs text-gray-400">暂无已关联结算单</div>}
            </div>
          </div>
        </section>

        <section className="rounded-2xl border border-gray-200 bg-white p-4">
          <div className="flex items-center justify-between gap-2">
            <div>
              <h3 className="text-sm font-semibold text-gray-800">⑥ 发票 · ⑦ 认证</h3>
              <p className="mt-1 text-[11px] text-gray-400">来源为税务系统导出的官方清单</p>
            </div>
            <Link href="/tax-invoices" className="text-[11px] font-medium text-indigo-600 hover:text-indigo-700">打开税务台账 →</Link>
          </div>
          <div className="mt-3 space-y-2">
            {row.invoice.length ? row.invoice.map((invoice) => <InvoiceItem key={invoice.invoiceId} invoice={invoice} busy={busy} onVerify={onVerify} />) : (
              <div className="rounded-xl border border-dashed border-amber-200 bg-amber-50/40 px-3 py-6 text-center text-xs text-amber-700">尚未关联进项发票</div>
            )}
          </div>
          <div className="mt-3 flex items-center justify-between rounded-lg bg-gray-50 px-3 py-2 text-xs">
            <span className="text-gray-500">认证状态</span>
            <span className={row.verified ? "font-medium text-emerald-700" : "text-gray-400"}>{row.verified ? "已认证抵扣" : "未认证"}</span>
          </div>
        </section>
      </div>
    </div>
  );
}

export default function ProcurementLedgerPage() {
  const [overview, setOverview] = useState<ChainOverview | null>(null);
  const [orders, setOrders] = useState<ChainOrderRow[]>([]);
  const [pending, setPending] = useState<PendingLink[]>([]);
  const [selectedId, setSelectedId] = useState<number | null>(null);
  const [filter, setFilter] = useState<Filter>("all");
  const [query, setQuery] = useState("");
  const [busy, setBusy] = useState(false);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  const load = useCallback(async () => {
    setError("");
    try {
      const [nextOverview, nextOrders, nextPending] = await Promise.all([
        procurementChainApi.overview(),
        procurementChainApi.orders(500),
        procurementChainApi.pending(),
      ]);
      setOverview(nextOverview);
      setOrders(nextOrders.items);
      setPending(nextPending.items);
      setSelectedId((current) => current && nextOrders.items.some((row) => row.orderId === current) ? current : (nextOrders.items[0]?.orderId ?? null));
    } catch (err) {
      setError(err instanceof Error ? err.message : "采购链路数据加载失败");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void load(); }, [load]);

  const filteredOrders = useMemo(() => {
    const normalized = query.trim().toLowerCase();
    return orders.filter((row) => {
      const done = progress(row);
      const searchable = [row.orderNo, row.supplier, row.buyer, row.title, ...row.purchaseOrders.map((item) => item.purchNo)].join(" ").toLowerCase();
      if (normalized && !searchable.includes(normalized)) return false;
      if (filter === "attention" && done === 7) return false;
      if (filter === "complete" && done !== 7) return false;
      if (filter === "sku" && row.purchaseContentComplete) return false;
      if (filter === "jackyun" && (row.purchaseOrders.length !== 0 || row.externalPoId === null)) return false;
      if (filter === "tax" && row.invoice.length > 0 && row.verified) return false;
      return true;
    });
  }, [filter, orders, query]);

  const selected = orders.find((row) => row.orderId === selectedId) ?? null;
  const stats = useMemo(() => ({
    total: orders.length,
    complete: orders.filter((row) => progress(row) === 7).length,
    sku: orders.filter((row) => !row.purchaseContentComplete).length,
    docs: orders.filter((row) => row.externalPoId !== null && row.purchaseOrders.length === 0).length,
    tax: orders.filter((row) => row.invoice.length === 0 || !row.verified).length,
  }), [orders]);

  async function runMatch() {
    setBusy(true);
    setNotice("");
    try {
      const result = await procurementChainApi.runMatch();
      setNotice(result.created > 0 ? `自动匹配完成，新增 ${result.created} 条建议` : "自动匹配完成，暂无新的关联建议");
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "自动匹配失败");
    } finally {
      setBusy(false);
    }
  }

  async function handlePending(item: PendingLink, action: "confirm" | "reject") {
    setBusy(true);
    try {
      if (action === "confirm") {
        if (item.kind === "invoice") await procurementChainApi.confirmInvoiceLink(item.linkId);
        else await procurementChainApi.confirmLink(item.linkId);
      } else if (item.kind === "invoice") {
        await procurementChainApi.deleteInvoiceLink(item.linkId);
      } else {
        await procurementChainApi.deleteLink(item.linkId);
      }
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "关联操作失败");
    } finally {
      setBusy(false);
    }
  }

  async function verifyInvoice(invoice: ChainInvoice) {
    setBusy(true);
    try {
      const now = new Date();
      const month = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
      await procurementChainApi.verifyInvoice(invoice.invoiceId, !invoice.verified, invoice.verified ? invoice.verifiedMonth : month);
      await load();
    } catch (err) {
      setError(err instanceof Error ? err.message : "发票认证状态更新失败");
    } finally {
      setBusy(false);
    }
  }

  if (loading) return <div className="flex min-h-[60vh] items-center justify-center text-sm text-gray-400">加载采购台账…</div>;

  return (
    <div className="min-h-full pb-10">
      <header className="flex flex-wrap items-start justify-between gap-4 border-b border-gray-200 pb-5">
        <div>
          <div className="flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-indigo-600">
            <span className="h-2 w-2 rounded-full bg-indigo-600" /> 新版采购台账
          </div>
          <h1 className="mt-2 text-2xl font-semibold tracking-tight text-gray-950">采购闭环</h1>
          <p className="mt-2 max-w-2xl text-sm leading-6 text-gray-500">以 1688 订单为主键，把实际 SKU、吉客云采购入单、入库、付款、税票和认证放在同一条业务链中核对。</p>
        </div>
        <div className="flex flex-wrap gap-2">
          <Link href="/alibaba1688-import" className="rounded-xl border border-gray-200 bg-white px-3 py-2 text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50">导入 1688 订单</Link>
          <Link href="/jackyun-import" className="rounded-xl border border-gray-200 bg-white px-3 py-2 text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50">导入吉客云资料</Link>
          <button onClick={() => void runMatch()} disabled={busy} className="rounded-xl bg-indigo-600 px-3 py-2 text-xs font-medium text-white shadow-sm hover:bg-indigo-700 disabled:opacity-50">{busy ? "处理中…" : "自动匹配"}</button>
          <button onClick={() => void load()} disabled={busy} className="rounded-xl border border-gray-200 bg-white px-3 py-2 text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50 disabled:opacity-50">刷新</button>
        </div>
      </header>

      {error && <div className="mt-4 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-xs text-red-700">{error}</div>}
      {notice && <div className="mt-4 rounded-xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-xs text-emerald-700">{notice}</div>}

      <section className="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
        {[
          { label: "1688 订单", value: overview?.total ?? stats.total, hint: "一行一个来源订单", tone: "indigo" },
          { label: "已闭环", value: stats.complete, hint: `${stats.total ? Math.round((stats.complete / stats.total) * 100) : 0}% 完成 7 个环节`, tone: "emerald" },
          { label: "待完善 SKU", value: stats.sku, hint: "需要落到吉客云主档", tone: "amber" },
          { label: "待关联吉客云单", value: stats.docs, hint: "默认一单一入单", tone: "sky" },
          { label: "待处理税票", value: stats.tax, hint: "未关联或未认证", tone: "rose" },
        ].map((card) => {
          const toneClass: Record<string, string> = {
            indigo: "bg-indigo-500",
            emerald: "bg-emerald-500",
            amber: "bg-amber-500",
            sky: "bg-sky-500",
            rose: "bg-rose-500",
          };
          return (
            <div key={card.label} className="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
              <div className="flex items-center justify-between gap-2"><span className="text-xs text-gray-500">{card.label}</span><span className={`h-2 w-2 rounded-full ${toneClass[card.tone]}`} /></div>
              <div className="mt-2 text-2xl font-semibold tabular-nums text-gray-950">{card.value}</div>
              <div className="mt-1 text-[11px] text-gray-400">{card.hint}</div>
            </div>
          );
        })}
      </section>

      {pending.length > 0 && (
        <section className="mt-5 rounded-2xl border border-amber-200 bg-amber-50/60 p-4">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <div><h2 className="text-sm font-semibold text-amber-900">有 {pending.length} 条关联建议待确认</h2><p className="mt-1 text-[11px] text-amber-700">确认前不会把猜测关系写成正式业务关系。</p></div>
            <span className="rounded-full bg-amber-100 px-2 py-1 text-[10px] font-medium text-amber-700">人工确认区</span>
          </div>
          <div className="mt-3 grid gap-2 lg:grid-cols-2">
            {pending.slice(0, 4).map((item) => (
              <div key={`${item.kind}-${item.linkId}`} className="flex items-center justify-between gap-3 rounded-xl border border-amber-100 bg-white px-3 py-2">
                <div className="min-w-0"><div className="flex items-center gap-2 text-xs"><span className="font-mono font-medium text-gray-800">{item.orderNo}</span><span className="text-gray-300">→</span><span className="truncate text-indigo-700">{item.targetNo}</span></div><div className="mt-1 text-[10px] text-gray-400">{item.targetType === "inbound" ? "入库" : item.targetType === "settlement" ? "付款" : "发票"}{item.confidence === null ? "" : ` · 置信度 ${(item.confidence * 100).toFixed(0)}%`}</div></div>
                <div className="flex shrink-0 gap-1.5"><button onClick={() => void handlePending(item, "confirm")} disabled={busy} className="rounded-lg bg-indigo-600 px-2 py-1 text-[10px] font-medium text-white disabled:opacity-50">确认</button><button onClick={() => void handlePending(item, "reject")} disabled={busy} className="rounded-lg border border-gray-200 px-2 py-1 text-[10px] text-gray-500 disabled:opacity-50">拒绝</button></div>
              </div>
            ))}
          </div>
          {pending.length > 4 && <div className="mt-2 text-[11px] text-amber-700">还有 {pending.length - 4} 条建议，先按订单筛选后逐笔处理。</div>}
        </section>
      )}

      <section className="mt-5 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-4 py-3">
          <div><h2 className="text-sm font-semibold text-gray-800">订单台账</h2><p className="mt-1 text-[11px] text-gray-400">左侧选择订单，右侧查看完整链路</p></div>
          <div className="flex flex-wrap items-center gap-2">
            <input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="搜索订单号 / 供应商 / 采购单号" className="w-64 rounded-lg border border-gray-200 px-3 py-1.5 text-xs outline-none focus:border-indigo-300 focus:ring-2 focus:ring-indigo-50" />
            <select value={filter} onChange={(event) => setFilter(event.target.value as Filter)} className="rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs text-gray-600 outline-none focus:border-indigo-300">
              {FILTERS.map((item) => <option key={item.key} value={item.key}>{item.label}</option>)}
            </select>
          </div>
        </div>

        <div className="grid min-h-[620px] lg:grid-cols-[minmax(0,1fr)_minmax(390px,0.85fr)]">
          <div className="min-w-0 border-b border-gray-100 lg:border-b-0 lg:border-r">
            <div className="hidden grid-cols-[minmax(170px,1.2fr)_100px_150px_130px_90px] gap-3 border-b border-gray-100 bg-gray-50/70 px-4 py-2.5 text-[10px] font-medium uppercase tracking-wide text-gray-400 xl:grid">
              <span>1688 订单 / 供应商</span><span className="text-right">实付</span><span>环节进度</span><span>关键缺口</span><span className="text-right">完成度</span>
            </div>
            <div className="divide-y divide-gray-100">
              {filteredOrders.map((row) => {
                const done = progress(row);
                const selectedRow = row.orderId === selectedId;
                const gap = !row.purchaseContentComplete ? "待完善 SKU" : row.purchaseOrders.length === 0 ? "待关联采购单" : row.invoice.length === 0 ? "待关联发票" : !row.verified ? "待认证" : "已闭环";
                return (
                  <button key={row.orderId} onClick={() => setSelectedId(row.orderId)} className={`grid w-full grid-cols-1 gap-3 px-4 py-3 text-left transition-colors sm:grid-cols-[minmax(170px,1.2fr)_100px_150px_130px_90px] xl:grid ${selectedRow ? "bg-indigo-50/70" : "hover:bg-gray-50"}`}>
                    <div className="min-w-0"><div className="flex items-center gap-2"><span className="h-2 w-2 shrink-0 rounded-full bg-indigo-500" /><span className="truncate font-mono text-xs font-medium text-gray-800">{row.orderNo}</span></div><div className="mt-1 truncate pl-4 text-xs text-gray-500" title={row.supplier || row.title}>{row.supplier || row.title || "未填写供应商"}</div><div className="mt-1 pl-4 text-[10px] text-gray-400">{date(row.orderDate)} · {row.orderStatus || "已成交"}</div></div>
                    <div className="flex items-center justify-between text-xs tabular-nums text-gray-700 sm:block sm:text-right"><span className="mr-2 text-[10px] text-gray-400 sm:hidden">实付</span>{money(row.paidAmount ?? row.amount)}</div>
                    <div className="flex items-center overflow-x-auto pb-0.5"><StageStrip row={row} /></div>
                    <div className="flex items-center text-[11px]"><span className={`rounded-full px-2 py-1 ${gap === "已闭环" ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700"}`}>{gap}</span></div>
                    <div className="flex items-center justify-between text-right sm:block"><span className="mr-2 text-[10px] text-gray-400 sm:hidden">完成度</span><span className={`text-sm font-semibold tabular-nums ${done === 7 ? "text-emerald-600" : "text-amber-600"}`}>{done}/7</span><div className="mt-1 ml-auto hidden h-1 w-14 overflow-hidden rounded-full bg-gray-100 sm:block"><div className={`h-full rounded-full ${done === 7 ? "bg-emerald-500" : "bg-amber-400"}`} style={{ width: `${(done / 7) * 100}%` }} /></div></div>
                  </button>
                );
              })}
              {filteredOrders.length === 0 && <div className="px-6 py-16 text-center"><div className="text-sm text-gray-500">没有符合条件的订单</div><div className="mt-1 text-xs text-gray-400">请调整搜索或筛选条件</div></div>}
            </div>
          </div>

          <aside className="bg-gray-50/50 p-4 lg:max-h-[calc(100vh-230px)] lg:overflow-y-auto">
            {selected ? <OrderDetail row={selected} busy={busy} onVerify={(invoice) => void verifyInvoice(invoice)} /> : <div className="flex h-full min-h-[420px] items-center justify-center text-center text-sm text-gray-400">选择左侧订单查看链路详情</div>}
          </aside>
        </div>
      </section>
    </div>
  );
}
