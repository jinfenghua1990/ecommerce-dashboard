          {STAGES.map((stage) => <StagePill key={stage.key} row={row} stage={stage} />)}
        </div>
      </div>

      <section className="rounded-2xl border border-gray-200 bg-white p-4">
        <div className="flex items-center justify-between">
          <div>
            <h3 className="text-sm font-semibold text-gray-800">① 1688 来源订单</h3>
            <p className="mt-1 text-[11px] text-gray-400">来源只读，作为整条采购链的唯一业务起点</p>
          </div>
          <span className="rounded-full bg-indigo-50 px-2 py-1 text-[10px] font-medium text-indigo-700">{row.source === "file" ? "导出文件" : "工作流登记"}</span>
        </div>
        <div className="mt-3 grid gap-x-6 sm:grid-cols-2">
