"use client";

import Link from "next/link";
import { useCallback, useEffect, useMemo, useState } from "react";
import {
  ChainInvoice,
  ChainOrderRow,
  ChainOverview,
  PendingLink,
  procurementChainApi,
} from "@/lib/api";

type Filter = "all" | "attention" | "complete" | "sku" | "jackyun" | "tax";
type StageKey = "purchase" | "sku" | "jackyun" | "inbound" | "paid" | "invoice" | "verified";

const FILTERS: { key: Filter; label: string }[] = [
  { key: "all", label: "全部订单" },
  { key: "attention", label: "有待办" },
  { key: "complete", label: "已闭环" },
  { key: "sku", label: "待完善 SKU" },
  { key: "jackyun", label: "待关联吉客云单" },
  { key: "tax", label: "待处理发票" },
];

const STAGES: { key: StageKey; label: string; short: string }[] = [
  { key: "purchase", label: "1688 订单", short: "订单" },
  { key: "sku", label: "实际采购内容", short: "SKU" },
  { key: "jackyun", label: "吉客云采购单", short: "采购单" },
  { key: "inbound", label: "入库", short: "入库" },
  { key: "paid", label: "付款", short: "付款" },
  { key: "invoice", label: "税务发票", short: "发票" },
  { key: "verified", label: "认证", short: "认证" },
];

function money(value: number | null | undefined): string {
  if (value === null || value === undefined) return "—";
  return `¥${value.toLocaleString("zh-CN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}

function date(value: string | null | undefined): string {
  if (!value) return "—";
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return "—";
  return parsed.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
}

function statusLabel(status: string): string {
  const labels: Record<string, string> = {
    pending_refine: "待完善采购内容",
    confirmed: "采购内容已确认",
    jackyun_linked: "已关联吉客云采购单",
    producing: "生产中",
    shipped: "已发货",
    arrived: "已到货",
    inbound: "已入库",
    done: "已完成",
  };
  return labels[status] ?? (status || "待完善");
}

function progress(row: ChainOrderRow): number {
  let done = 1;
  if (row.purchaseContentComplete) done += 1;
  if (row.purchaseOrders.length === 1) done += 1;
  if (row.inbound.length > 0) done += 1;
  if (row.settlement.some((item) => item.paid)) done += 1;
  if (row.invoice.length > 0) done += 1;
  if (row.verified) done += 1;
  return done;
}

function stageDone(row: ChainOrderRow, key: StageKey): boolean {
  switch (key) {
    case "purchase":
      return true;
    case "sku":
      return row.purchaseContentComplete;
    case "jackyun":
      return row.purchaseOrders.length === 1;
    case "inbound":
      return row.inbound.length > 0;
    case "paid":
      return row.settlement.some((item) => item.paid);
    case "invoice":
      return row.invoice.length > 0;
    case "verified":
      return row.verified;
  }
}

function StagePill({ row, stage }: { row: ChainOrderRow; stage: (typeof STAGES)[number] }) {
  const done = stageDone(row, stage.key);
  const warning = stage.key === "jackyun" && row.purchaseOrders.length > 1;
  return (
    <div
      title={`${stage.label}：${done ? "已完成" : "待处理"}`}
      className={`flex min-w-[74px] flex-col items-center gap-1 rounded-xl border px-2 py-2 text-center ${
        warning
          ? "border-amber-200 bg-amber-50 text-amber-700"
          : done
            ? "border-emerald-100 bg-emerald-50 text-emerald-700"
            : "border-gray-100 bg-gray-50 text-gray-400"
      }`}
    >
      <span className={`flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-semibold ${
        warning ? "bg-amber-500 text-white" : done ? "bg-emerald-500 text-white" : "bg-gray-200 text-gray-500"
      }`}>
        {warning ? "!" : done ? "✓" : "·"}
      </span>
      <span className="text-[10px] font-medium">{stage.short}</span>
    </div>
  );
}

function StageStrip({ row }: { row: ChainOrderRow }) {
  return (
    <div className="flex items-center gap-1.5" title="订单 · SKU · 吉客云采购单 · 入库 · 付款 · 发票 · 认证">
      {STAGES.map((stage, index) => (
        <span key={stage.key} className="flex items-center gap-1.5">
          <span
            className={`flex h-5 w-5 items-center justify-center rounded-full text-[9px] font-semibold ${
              stageDone(row, stage.key) ? "bg-emerald-500 text-white" : "bg-gray-200 text-gray-500"
            }`}
          >
            {stageDone(row, stage.key) ? "✓" : index + 1}
          </span>
          {index < STAGES.length - 1 && <span className="h-px w-2 bg-gray-200" />}
        </span>
      ))}
    </div>
  );
}

function DetailRow({ label, value }: { label: string; value: React.ReactNode }) {
  return (
    <div className="flex items-start justify-between gap-4 border-b border-gray-50 py-2 last:border-0">
      <span className="shrink-0 text-xs text-gray-400">{label}</span>
      <span className="min-w-0 text-right text-xs text-gray-700">{value}</span>
    </div>
  );
}

function InvoiceItem({ invoice, busy, onVerify }: { invoice: ChainInvoice; busy: boolean; onVerify: (invoice: ChainInvoice) => void }) {
  return (
    <div className="rounded-xl border border-amber-100 bg-amber-50/40 p-3">
      <div className="flex items-center justify-between gap-2">
        <span className="font-mono text-xs font-medium text-gray-800">{invoice.invoiceNo || "未提供发票号码"}</span>
        <span className={`rounded-full px-2 py-0.5 text-[10px] font-medium ${invoice.verified ? "bg-emerald-100 text-emerald-700" : "bg-white text-amber-700"}`}>
          {invoice.verified ? "已认证" : "未认证"}
        </span>
      </div>
      <div className="mt-2 flex items-center justify-between text-[11px] text-gray-500">
        <span>{date(invoice.issueDate)}</span>
        <span className="font-medium tabular-nums text-gray-700">{money(invoice.amount)}</span>
      </div>
      <button
        onClick={() => onVerify(invoice)}
        disabled={busy}
        className={`mt-2 rounded-lg px-2.5 py-1 text-[11px] font-medium disabled:opacity-50 ${invoice.verified ? "bg-emerald-600 text-white hover:bg-emerald-700" : "bg-white text-gray-600 ring-1 ring-gray-200 hover:bg-gray-50"}`}
      >
        {invoice.verified ? "取消认证" : "标记本月已认证"}
      </button>
    </div>
  );
}

