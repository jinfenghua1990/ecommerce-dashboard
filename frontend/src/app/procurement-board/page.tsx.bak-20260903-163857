        </thead>
        <tbody className="divide-y divide-gray-50">
          {allocations.map((allocation) => (
            <tr key={allocation.id}>
              <td className="max-w-[170px] truncate px-2 py-2 text-gray-700" title={allocation.goodsName}>{allocation.goodsName || "—"}</td>
              <td className="px-2 py-2 font-mono text-violet-600">{allocation.skuCode || "—"}</td>
              <td className="px-2 py-2 text-right tabular-nums text-gray-600">{allocation.quantity ?? "—"}</td>
              <td className="px-2 py-2 text-right tabular-nums text-gray-600">{fmtMoney(allocation.unitPrice)}</td>
              <td className="px-2 py-2 text-right font-semibold tabular-nums text-gray-800">{fmtMoney(allocation.amount)}</td>
              <td className="px-2 py-2 text-right tabular-nums text-gray-700">{fmtMoney(allocation.amount)}</td>
              <td className="px-2 py-2 text-right"><Link href="/purchase" className="text-indigo-600 hover:text-indigo-700">编辑</Link></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function PaymentBreakdownRow({ breakdown }: { breakdown: BoardPaymentBreakdown }) {
  const tone = (v: number) => (v > 0 ? "text-gray-800 font-semibold" : "text-gray-400");
  return (
    <div className="grid grid-cols-4 gap-3 md:grid-cols-8">
      <Cell label="商品金额(¥)" value={breakdown.goodsAmount} tone={tone(breakdown.goodsAmount)} />
      <Cell label="运费(¥)" value={breakdown.freight} tone={tone(breakdown.freight)} />
      <Cell label="附加费用(¥)" value={breakdown.extra} tone={tone(breakdown.extra)} />
      <Cell label="优惠(抵扣)(¥)" value={breakdown.discount} tone="text-emerald-600" />
      <Cell label="应付款(¥)" value={breakdown.totalDue} tone="text-rose-600 font-semibold" />
      <Cell label="已付款(¥)" value={breakdown.paidAmount} tone="text-emerald-600" />
      <Cell label="未付款(¥)" value={breakdown.unpaidAmount} tone="text-amber-700" />
      <Cell label="金额差异(¥)" value={breakdown.diffAmount} tone={tone(breakdown.diffAmount)} />
    </div>
  );
}

function Cell({ label, value, tone }: { label: string; value: number; tone: string }) {
  return (
    <div className="rounded-lg border border-gray-100 bg-white px-2.5 py-2">
      <div className="text-[10.5px] text-gray-400">{label}</div>
      <div className={`mt-0.5 text-[13px] tabular-nums ${tone}`}>{fmtMoney(value)}</div>
    </div>
  );
}

