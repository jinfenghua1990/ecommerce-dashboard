  return (
    <div className="overflow-x-auto">
      <table className="w-full min-w-[680px] text-[11px]">
        <thead className="border-b border-gray-100 text-left text-[10px] text-gray-400">
          <tr>
            <th className="px-2 py-1.5 font-medium">1688 商品</th>
            <th className="px-2 py-1.5 font-medium">吉客云 SKU</th>
            <th className="px-2 py-1.5 text-right font-medium">采购数量</th>
            <th className="px-2 py-1.5 text-right font-medium">单价(¥)</th>
            <th className="px-2 py-1.5 text-right font-medium">金额(¥)</th>
            <th className="px-2 py-1.5 text-right font-medium">入行付款(¥)</th>
            <th className="px-2 py-1.5 text-right font-medium">操作</th>
