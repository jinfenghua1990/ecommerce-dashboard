    <section className="border-b border-gray-100 px-4 py-3 last:border-0">
      <div className="mb-2 flex items-center justify-between">
        <h3 className="text-[13px] font-semibold text-gray-800">{title}</h3>
        {rightSlot}
      </div>
      {children}
    </section>
  );
}

function Field({
  label,
  value,
  mono,
  strong,
  truncate,
  fullSpan,
}: {
  label: string;
  value: string | null | undefined;
  mono?: boolean;
  strong?: boolean;
  truncate?: boolean;
  fullSpan?: boolean;
}) {
  return (
    <div className={fullSpan ? "col-span-2 md:col-span-4" : ""}>
      <div className="text-[10.5px] text-gray-400">{label}</div>
      <div
        className={`mt-0.5 ${mono ? "font-mono" : ""} ${strong ? "text-[15px] font-semibold" : "text-[12.5px]"} text-gray-700 ${
          truncate ? "truncate" : ""
        }`}
        title={value || ""}
      >
        {value || "—"}
      </div>
    </div>
  );
}

function FlowStatusBar({ steps }: { steps: BoardFlowStep[] }) {
  return (
    <div className="space-y-2">
      {steps.map((s) => (
        <div key={s.no} className="flex items-center gap-3">
          <span
            className={`flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10.5px] font-medium ${
              s.done ? "bg-emerald-500 text-white" : "bg-gray-200 text-gray-500"
            }`}
          >
            {s.no}
          </span>
          <span className={`text-[12.5px] font-medium ${s.done ? "text-emerald-700" : "text-gray-700"}`}>
            {s.label}
          </span>
          <span className="text-[11px] text-gray-400">·</span>
          <span className={`text-[11.5px] ${s.done ? "text-emerald-600" : "text-amber-600"}`}>{s.detail}</span>
        </div>
      ))}
    </div>
  );
}

function SupplierProfileCard({ profile }: { profile: BoardSupplierProfile }) {
  return (
    <div className="space-y-2">
      <div className="flex items-center gap-2">
        <span className="text-[13px] font-semibold text-gray-800">{profile.supplierName}</span>
        <span className="rounded bg-emerald-50 px-1.5 py-0.5 text-[10.5px] font-medium text-emerald-700">
          {profile.badge}
