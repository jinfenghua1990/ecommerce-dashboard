          </div>
        </div>
      </div>

      <div className="mx-auto w-full max-w-[1440px] flex-1 space-y-4 px-6 py-4">
        {/* 顶部统计区：5 数字 + 1 付款率环 */}
        <section className="grid grid-cols-1 gap-3 md:grid-cols-3 lg:grid-cols-6">
          {overview && (
            <>
              <StatCard
                label="今日新增订单"
