// ---------- 工具函数 ----------

function fmtMoney(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  return "¥" + v.toLocaleString("zh-CN", { maximumFractionDigits: 2 });
}

function fmtDate(s: string | null | undefined): string {
  if (!s) return "—";
  const d = new Date(s);
  if (Number.isNaN(d.getTime())) return "—";
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
}

function fmtDateTime(s: string | null | undefined): string {
  if (!s) return "—";
  const d = new Date(s);
  if (Number.isNaN(d.getTime())) return "—";
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")} ${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}:${String(d.getSeconds()).padStart(2, "0")}`;
}

function copyText(t: string) {
  if (typeof window === "undefined") return;
  navigator.clipboard.writeText(t).catch(() => {});
}

const STATUS_BADGE: Record<string, string> = {
  待完善: "bg-amber-50 text-amber-700",
  待采购单: "bg-violet-50 text-violet-700",
  待入库: "bg-teal-50 text-teal-700",
  待发票: "bg-rose-50 text-rose-700",
  已完成: "bg-emerald-50 text-emerald-700",
};

function flowStatusLabel(steps: BoardFlowStep[]): string {
  const next = steps.find((step) => !step.done);
  if (!next) return "已完成";
  return ({
    "采购内容": "待完善",
    "吉客云采购单": "待采购单",
    "入库": "待入库",
    "发票": "待发票",
  } as Record<string, string>)[next.label] ?? "待处理";
}

function exportBoardOrders(orderList: BoardOrderList | null) {
  const rows = orderList?.groups.flatMap((group) => group.items) ?? [];
  if (!rows.length || typeof window === "undefined") return;
  const header = ["1688订单号", "供应商", "下单金额", "订单状态", "当前环节", "下单时间"];
  const lines = rows.map((row) => [row.orderNo, row.supplier, row.amount ?? "", row.orderStatus, row.firstUndoneLabel, row.orderDate ?? ""]);
  const csv = [header, ...lines]
    .map((line) => line.map((value) => `"${String(value).replaceAll('"', '""')}"`).join(","))
    .join("\n");
  const url = URL.createObjectURL(new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" }));
  const link = document.createElement("a");
  link.href = url;
  link.download = `采购工作台-${new Date().toISOString().slice(0, 10)}.csv`;
  link.click();
  URL.revokeObjectURL(url);
}

// ---------- 顶部统计卡（5 数字 + 1 付款率环） ----------

function StatCard({
  label,
  value,
  delta,
  tone,
  icon,
}: {
  label: string;
  value: string;
  delta?: string;
  tone?: "indigo" | "amber" | "violet" | "teal" | "rose";
  icon: React.ReactNode;
}) {
  const ring = {
    indigo: "ring-indigo-100 text-indigo-600",
    amber: "ring-amber-100 text-amber-600",
    violet: "ring-violet-100 text-violet-600",
    teal: "ring-teal-100 text-teal-600",
    rose: "ring-rose-100 text-rose-600",
  }[tone ?? "indigo"];
  return (
    <div className="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-4 py-3">
      <div>
        <div className="text-[12px] text-gray-500">{label}</div>
        <div className="mt-1 text-2xl font-semibold tabular-nums leading-7 text-gray-900">{value}</div>
        {delta && <div className="mt-0.5 text-[11px] text-gray-400">{delta}</div>}
      </div>
      <div className={`flex h-9 w-9 items-center justify-center rounded-lg ring-1 ${ring} bg-white`}>{icon}</div>
    </div>
  );
}

function PaidRateRing({ pct }: { pct: number }) {
  // SVG 环形进度：半径 30，stroke 6，c=2πr=188.5
  const r = 30;
  const c = 2 * Math.PI * r;
  const dash = (pct / 100) * c;
  return (
    <svg width="72" height="72" viewBox="0 0 72 72" aria-hidden>
      <circle cx="36" cy="36" r={r} stroke="#E5E7EB" strokeWidth="6" fill="none" />
      <circle
        cx="36"
        cy="36"
        r={r}
        stroke="#4F46E5"
        strokeWidth="6"
        fill="none"
        strokeLinecap="round"
        strokeDasharray={`${dash} ${c - dash}`}
        transform="rotate(-90 36 36)"
      />
      <text x="36" y="40" textAnchor="middle" fontSize="13" fontWeight="600" fill="#111827">
        {pct}%
      </text>
    </svg>
  );
}

