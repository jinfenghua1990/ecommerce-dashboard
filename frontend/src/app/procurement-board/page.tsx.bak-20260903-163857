          </div>
          <div className="flex shrink-0 items-center gap-2">
            <Link
              href="/alibaba1688-import"
              className="flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-1.5 text-[12px] font-medium text-white shadow-sm transition-colors hover:bg-indigo-700"
            >
