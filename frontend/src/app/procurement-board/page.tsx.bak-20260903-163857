        </thead>
        <tbody>
          {skus.slice(0, 8).map((sk) => (
            <tr key={sk.skuCode} className="border-b border-gray-50">
              <td className="py-1.5">
                <div className="flex items-center gap-2">
                  <div className="h-7 w-7 shrink-0 rounded bg-gray-100" />
