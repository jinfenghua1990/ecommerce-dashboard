              <td className="py-1.5 text-right tabular-nums">{sk.qty}</td>
              <td className="py-1.5 text-right tabular-nums">{fmtMoney(sk.unitPrice)}</td>
              <td className="py-1.5 text-right font-semibold tabular-nums text-gray-800">{fmtMoney(sk.amount)}</td>
