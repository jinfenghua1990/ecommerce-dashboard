function OrderDetailPanel({ detail, loading, onOrderChanged, onOpenSupplier }: {
  detail: WorkbenchDetail | null;
  loading: boolean;
  onOrderChanged: () => Promise<void>;
  onOpenSupplier: (name: string) => void;
}) {
  const [skuEditorOpen, setSkuEditorOpen] = useState(false);
  const [skuCatalog, setSkuCatalog] = useState<CatalogSkuRow[]>([]);
  const [skuCatalogLoading, setSkuCatalogLoading] = useState(false);
  const [skuQuery, setSkuQuery] = useState("");
  const [selectedSkuId, setSelectedSkuId] = useState<number | null>(null);
  const [skuQty, setSkuQty] = useState("1");
  const [skuPrice, setSkuPrice] = useState("");
  const [skuAction, setSkuAction] = useState("");
  const [skuMessage, setSkuMessage] = useState("");

  useEffect(() => {
    setSkuEditorOpen(false);
    setSkuQuery("");
    setSelectedSkuId(null);
    setSkuQty("1");
    setSkuPrice("");
    setSkuMessage("");
  }, [detail?.order.orderId]);

  useEffect(() => {
    if (!skuEditorOpen || skuCatalog.length > 0 || skuCatalogLoading) return;
    setSkuCatalogLoading(true);
    dashboardApi.products("", 500)
      .then(setSkuCatalog)
      .catch(() => setSkuMessage("吉客云 SKU 主档加载失败，请先检查商品同步状态"))
      .finally(() => setSkuCatalogLoading(false));
  }, [skuCatalog.length, skuCatalogLoading, skuEditorOpen]);

  if (loading && !detail) return <aside className="rounded-xl border border-slate-200 bg-white"><Loading text="正在加载订单详情…" /></aside>;
  if (!detail) return <aside className="flex min-h-[520px] items-center justify-center rounded-xl border border-slate-200 bg-white px-8 text-center text-[12px] text-slate-400">选择左侧订单查看执行详情</aside>;
  const { order, detail: records, stepStates } = detail;
  const allocations = records.allocations as AllocationRow[];
  const expenses = records.expenses as ExpenseRow[];
  const purchaseOrders = records.purchaseOrders as PurchaseOrderRow[];
  const inbound = records.inbound as InboundRow[];
  const invoices = records.invoice as InvoiceRow[];
  const settlements = records.settlement as SettlementRow[];
  const extraAmount = expenses.reduce((sum, row) => sum + (typeof row.amount === "number" ? row.amount : 0), 0);
  const paidAmount = settlements.reduce((sum, row) => {
    const amount = row.paidAmount ?? row.amount;
    return sum + (typeof amount === "number" ? amount : 0);
  }, 0);
  const payable = (order.goodsTotal ?? order.amount ?? 0) + (order.freight ?? 0) + extraAmount - (order.discount ?? 0);
  const unpaidAmount = Math.max(0, payable - paidAmount);
  const remainingAmount = records.unallocatedAmount ?? order.paidAmount ?? order.amount;
  const editable = !order.purchaseStatus || order.purchaseStatus === "pending_refine";
  const canConfirm = Boolean(
    order.externalPoId && editable && allocations.length > 0 &&
    remainingAmount !== null && remainingAmount !== undefined && Math.abs(remainingAmount) < 0.005
  );
  const normalizedSkuQuery = skuQuery.trim().toLowerCase();
  const matchingSkus = skuCatalog.filter((sku) => {
    if (!normalizedSkuQuery) return true;
    return `${sku.skuCode} ${sku.skuName} ${sku.goodsName} ${sku.barcode}`.toLowerCase().includes(normalizedSkuQuery);
  }).slice(0, 8);
  const selectedSku = skuCatalog.find((sku) => sku.id === selectedSkuId) ?? null;

  async function readMutation(res: Response) {
    const body = await res.json().catch(() => ({})) as { detail?: string; id?: number };
    if (!res.ok) throw new Error(body.detail || `操作失败（${res.status}）`);
    return body;
  }

  async function ensureExternalPoId() {
    if (order.externalPoId) return order.externalPoId;
    const res = await authenticatedFetch("/api/v1/purchase/orders", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        external_order_id: order.orderNo,
        supplier_name: order.supplier || "",
        title: order.title || "",
        ordered_at: order.orderDate,
        order_amount: order.amount === null ? null : String(order.amount),
        paid_amount: (order.paidAmount ?? order.amount) === null ? null : String(order.paidAmount ?? order.amount),
      }),
    });
    const body = await readMutation(res);
    if (!body.id) throw new Error("采购工作流创建成功，但未返回采购单 ID");
    return body.id;
  }

  async function addSkuAllocation() {
    if (!selectedSku || !skuQty || skuPrice === "") return;
    const quantity = Number(skuQty);
    const unitPrice = Number(skuPrice);
    if (!Number.isFinite(quantity) || quantity <= 0 || !Number.isFinite(unitPrice) || unitPrice < 0) {
      setSkuMessage("请填写有效的数量和单价");
      return;
    }
    setSkuAction("add");
    setSkuMessage("");
    try {
      const poId = await ensureExternalPoId();
      const res = await authenticatedFetch(`/api/v1/purchase/orders/${poId}/allocations`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          sku_id: selectedSku.id,
          sku_code: selectedSku.skuCode,
          goods_name: selectedSku.goodsName || selectedSku.skuName,
          quantity: skuQty,
          unit_price: skuPrice,
        }),
      });
      await readMutation(res);
      setSelectedSkuId(null);
      setSkuPrice("");
      setSkuMessage("SKU 已加入当前订单");
      await onOrderChanged();
    } catch (caught) {
      setSkuMessage(caught instanceof Error ? caught.message : "SKU 分配失败");
    } finally {
      setSkuAction("");
    }
  }

  async function confirmPurchaseContent() {
    if (!order.externalPoId || !canConfirm) return;
    setSkuAction("confirm");
    setSkuMessage("");
    try {
      const res = await authenticatedFetch(`/api/v1/purchase/orders/${order.externalPoId}/refine`, { method: "POST" });
      await readMutation(res);
      setSkuMessage("采购内容已确认，订单已进入待生成采购单阶段");
      await onOrderChanged();
    } catch (caught) {
      setSkuMessage(caught instanceof Error ? caught.message : "采购内容确认失败");
    } finally {
      setSkuAction("");
    }
  }

  return (
    <aside className="min-w-0 xl:sticky xl:top-5 xl:self-start">
      <div className="overflow-hidden rounded-xl border border-slate-200/90 bg-white shadow-[0_4px_18px_rgba(40,53,85,0.045)]">
        <div className="border-b border-slate-100 px-4 py-3.5">
          <div className="flex items-center justify-between text-[11px]"><span className="font-semibold text-slate-700">已选择订单</span><span className="font-medium text-indigo-600">订单详情</span></div>
          <div className="mt-3 flex items-start justify-between gap-3">
            <div className="min-w-0">
              <div className="flex items-center gap-1.5">
                <span className="truncate font-mono text-[13px] font-semibold text-slate-800">{order.orderNo}</span>
                <button onClick={() => navigator.clipboard?.writeText(order.orderNo)} className="shrink-0 text-slate-300 hover:text-indigo-500" title="复制订单号"><Icon name="copy" size={12} /></button>
                <span className="shrink-0 rounded bg-amber-50 px-1.5 py-0.5 text-[9px] font-medium text-amber-600">{stepStates.sku?.done ? "已匹配SKU" : "待匹配SKU"}</span>
              </div>
              <div className="mt-2 text-[9.5px] text-slate-400">下单时间：{fmtDateTime(order.orderDate)}　来源：1688</div>
              <div className="mt-1 truncate text-[10px] text-slate-500">供应商：{order.supplier || "—"}</div>
            </div>
            <div className="shrink-0 text-right">
              <div className="text-[9px] text-slate-400">订单金额</div>
              <div className="mt-1 text-[17px] font-semibold tabular-nums text-slate-900">{fmtMoney(order.amount)}</div>
              <div className="mt-0.5 text-[9px] text-slate-400">含运费 {fmtMoney(order.freight ?? 0)}</div>
            </div>
          </div>
        </div>
        <div className="space-y-2 p-3">
          <DetailSection title="基本信息">
            <div className="grid grid-cols-4 gap-2">
              <DetailField label="收货仓库" value="—" />
              <DetailField label="付款方式" value={paidAmount > 0 ? "已关联付款" : "未关联"} />
              <DetailField label="期望到货" value="—" />
              <DetailField label="备注" value={order.title || "—"} />
            </div>
          </DetailSection>
          <DetailSection title="SKU分配" badge={stepStates.sku?.done ? "已完成" : "待处理"}>
            {allocations.length > 0 ? (
              <div className="space-y-1.5">
                {allocations.slice(0, 4).map((row, index) => (
                  <div key={(row.skuCode || "sku") + index} className="flex items-center justify-between gap-2 rounded-md bg-slate-50 px-2.5 py-2">
                    <div className="min-w-0"><div className="truncate text-[10px] font-medium text-slate-700">{row.goodsName || "未命名商品"}</div><div className="mt-0.5 truncate font-mono text-[9px] text-indigo-500">{row.skuCode || "未关联SKU"}</div></div>
                    <div className="shrink-0 text-[9.5px] tabular-nums text-slate-500">×{row.quantity ?? "—"}　{fmtMoney(row.amount)}</div>
                  </div>
                ))}
                {allocations.length > 4 && <div className="text-[9px] text-slate-400">另有 {allocations.length - 4} 条 SKU 分配</div>}
              </div>
            ) : (
              <div className="rounded-md border border-amber-200 bg-amber-50/70 px-3 py-2">
                <span className="text-[10px] text-amber-700">未选择吉客云 SKU，可直接在本页完成分配</span>
              </div>
            )}
            <div className="mt-2 flex items-center justify-between gap-2 border-t border-slate-100 pt-2">
              <span className={cx("text-[9.5px] tabular-nums", remainingAmount !== null && Math.abs(remainingAmount) < 0.005 ? "text-emerald-600" : "text-amber-600")}>
                待分配 {fmtMoney(remainingAmount)}
              </span>
              <div className="flex items-center gap-1.5">
                {editable ? (
                  <button onClick={() => setSkuEditorOpen((open) => !open)} className="rounded-md bg-indigo-50 px-2.5 py-1.5 text-[9.5px] font-medium text-indigo-600 hover:bg-indigo-100">
                    {skuEditorOpen ? "收起分配" : allocations.length ? "继续分配" : "分配 SKU"}
                  </button>
                ) : <span className="text-[9px] text-emerald-600">采购内容已确认</span>}
                <Link href="/purchase" className="px-1.5 py-1 text-[9px] text-slate-400 hover:text-indigo-600">完整编辑</Link>
              </div>
            </div>
            {skuEditorOpen && editable && (
              <div className="mt-2 rounded-lg border border-indigo-100 bg-indigo-50/30 p-2.5">
                <div className="flex items-center gap-2 rounded-md border border-slate-200 bg-white px-2.5">
                  <Icon name="search" size={13} />
                  <input value={skuQuery} onChange={(event) => setSkuQuery(event.target.value)} placeholder="搜索 SKU、商品名称或条码" className="h-8 min-w-0 flex-1 bg-transparent text-[10px] outline-none placeholder:text-slate-400" />
                </div>
                <div className="mt-2 max-h-36 space-y-1 overflow-y-auto">
                  {skuCatalogLoading ? <div className="py-3 text-center text-[9.5px] text-slate-400">正在读取吉客云 SKU 主档…</div> : matchingSkus.length > 0 ? matchingSkus.map((sku) => (
                    <button key={sku.id} onClick={() => {
                      setSelectedSkuId(sku.id);
                      if (!skuPrice && remainingAmount !== null && remainingAmount !== undefined && Number(skuQty) > 0) {
                        setSkuPrice((remainingAmount / Number(skuQty)).toFixed(2));
                      }
                    }} className={cx(
                      "flex w-full items-center justify-between gap-2 rounded-md border px-2.5 py-2 text-left",
                      selectedSkuId === sku.id ? "border-indigo-300 bg-white ring-1 ring-indigo-100" : "border-transparent bg-white/70 hover:border-slate-200"
                    )}>
                      <span className="min-w-0"><span className="block truncate text-[9.5px] font-medium text-slate-700">{sku.goodsName || sku.skuName || "未命名商品"}</span><span className="mt-0.5 block truncate font-mono text-[8.5px] text-indigo-500">{sku.skuCode}</span></span>
                      <span className="shrink-0 text-[8.5px] text-slate-400">{sku.unit || "—"}</span>
                    </button>
                  )) : <div className="py-3 text-center text-[9.5px] text-slate-400">没有匹配的吉客云 SKU</div>}
                </div>
                <div className="mt-2 grid grid-cols-2 gap-2">
                  <label className="text-[8.5px] text-slate-400">数量<input type="number" min="0.0001" step="0.0001" value={skuQty} onChange={(event) => setSkuQty(event.target.value)} className="mt-1 h-8 w-full rounded-md border border-slate-200 bg-white px-2 text-[10px] text-slate-700 outline-none focus:border-indigo-300" /></label>
                  <label className="text-[8.5px] text-slate-400">单价<input type="number" min="0" step="0.01" value={skuPrice} onChange={(event) => setSkuPrice(event.target.value)} className="mt-1 h-8 w-full rounded-md border border-slate-200 bg-white px-2 text-[10px] text-slate-700 outline-none focus:border-indigo-300" /></label>
                </div>
                {selectedSku && <div className="mt-2 truncate text-[9px] text-slate-500">已选：<span className="font-mono text-indigo-600">{selectedSku.skuCode}</span> · {selectedSku.goodsName || selectedSku.skuName}</div>}
                <div className="mt-2 flex items-center justify-between gap-2">
                  <span className="text-[9px] text-slate-400">本次金额 {fmtMoney(Number(skuQty) * Number(skuPrice))}</span>
                  <button disabled={skuAction !== "" || !selectedSku || !skuQty || skuPrice === ""} onClick={addSkuAllocation} className="rounded-md bg-indigo-600 px-3 py-1.5 text-[9.5px] font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">{skuAction === "add" ? "正在保存…" : "加入当前订单"}</button>
                </div>
              </div>
            )}
            {(skuMessage || canConfirm) && (
              <div className="mt-2 flex items-center justify-between gap-2 rounded-md bg-slate-50 px-2.5 py-2">
                <span className={cx("text-[9px]", skuMessage.includes("失败") || skuMessage.includes("请") ? "text-red-500" : "text-slate-500")}>{skuMessage || "金额已经分配平衡，可以确认采购内容"}</span>
                {canConfirm && <button disabled={skuAction !== ""} onClick={confirmPurchaseContent} className="shrink-0 rounded-md bg-emerald-600 px-2.5 py-1.5 text-[9.5px] font-medium text-white disabled:opacity-40">{skuAction === "confirm" ? "确认中…" : "确认采购内容"}</button>}
              </div>
            )}
          </DetailSection>
          <DetailSection title="费用分摊">
            <div className="grid grid-cols-3 gap-2">
              <DetailField label="商品金额" value={fmtMoney(order.goodsTotal ?? order.amount)} strong />
              <DetailField label="运费" value={fmtMoney(order.freight ?? 0)} strong />
              <DetailField label="优惠/抵扣" value={fmtMoney(order.discount ?? 0)} strong />
              <DetailField label="其它费用" value={fmtMoney(extraAmount)} strong />
              <DetailField label="应付款" value={fmtMoney(payable)} strong />
              <DetailField label="已付款" value={fmtMoney(paidAmount)} strong />
              <DetailField label="未付款" value={fmtMoney(unpaidAmount)} strong />
            </div>
          </DetailSection>
          <DetailSection title="吉客云采购单关联">
            {purchaseOrders.length > 0 ? (
              <div className="space-y-1.5">{purchaseOrders.slice(0, 3).map((row, index) => (
                <div key={(row.purchNo || "po") + index} className="flex items-center justify-between gap-2 rounded-md bg-indigo-50/60 px-2.5 py-2 text-[10px]">
                  <span className="truncate font-mono font-medium text-indigo-600">{row.purchNo || "已关联采购单"}</span>
                  <span className="shrink-0 text-slate-500">{fmtMoney(row.amount)}　{row.status || ""}</span>
                </div>
              ))}</div>
            ) : (
              <div className="flex items-center justify-between gap-2"><span className="text-[10px] text-slate-400">未生成采购单</span><Link href="/jackyun-import" className="rounded-md bg-indigo-600 px-2.5 py-1.5 text-[9.5px] font-medium text-white">生成采购单</Link></div>
            )}
          </DetailSection>
          <StatusSection title="入库状态" status={inbound.length > 0 ? "已入库" : "未入库"} records={inbound.map((row) => row.goodsdocNo || row.warehouseName || row.status || "已关联入库单")} href="/jackyun-import" />
          <StatusSection title="发票状态" status={invoices.length > 0 ? "已开票" : "未开票"} records={invoices.map((row) => row.invoiceNo || row.status || "已关联发票")} href="/tax-invoices" />
        </div>
      </div>
      {detail.supplierHistory && (
        <div className="mt-3 rounded-xl border border-slate-200/90 bg-white p-4 shadow-[0_4px_18px_rgba(40,53,85,0.04)]">
          <div className="flex items-center justify-between"><h3 className="text-[12px] font-semibold text-slate-800">供应商画像</h3><button onClick={() => order.supplier && onOpenSupplier(order.supplier)} className="text-[9.5px] font-medium text-indigo-600">查看详情 ›</button></div>
          <div className="mt-3 grid grid-cols-3 gap-2">
            <ProfileMetric icon="box" label="常购商品" value={String(detail.supplierHistory.oftenSkus.length)} />
            <ProfileMetric icon="receipt" label="未开票金额" value={fmtMoney(detail.supplierHistory.uninvoiced)} />
            <ProfileMetric icon="purchase" label="最近一次采购" value={fmtDate(detail.supplierHistory.lastOrderDate)} />
          </div>
          <div className="mt-3 flex flex-wrap items-center gap-1.5 text-[9px]">
            <span className="text-slate-400">供应商标签：</span><span className="rounded bg-blue-50 px-2 py-1 text-blue-600">合作供应商</span>
            {detail.supplierHistory.orderCount >= 5 && <span className="rounded bg-emerald-50 px-2 py-1 text-emerald-600">稳定合作</span>}
            {detail.supplierHistory.orderCount === 1 && <span className="rounded bg-violet-50 px-2 py-1 text-violet-600">首次采购</span>}
          </div>
        </div>
      )}
    </aside>
  );
}

function DetailSection({ title, badge, children }: { title: string; badge?: string; children: ReactNode }) {
  return (
    <details open className="rounded-lg border border-slate-200/80 bg-white">
      <summary className="flex cursor-pointer list-none items-center justify-between px-3 py-2.5">
        <span className="text-[10.5px] font-semibold text-slate-700">{title}</span>
        <span className="flex items-center gap-2 text-[9px] text-slate-400">{badge}<Icon name="chevron" size={12} /></span>
      </summary>
      <div className="border-t border-slate-100 px-3 py-2.5">{children}</div>
    </details>
  );
}

function DetailField({ label, value, strong }: { label: string; value: string; strong?: boolean }) {
  return <div className="min-w-0"><div className="text-[8.5px] text-slate-400">{label}</div><div className={cx("mt-1 truncate text-[9.5px] text-slate-600", strong && "text-[10.5px] font-semibold tabular-nums text-slate-800")} title={value}>{value}</div></div>;
}

function StatusSection({ title, status, records, href }: { title: string; status: string; records: string[]; href: string }) {
  return (
    <div className="rounded-lg border border-slate-200/80 bg-white px-3 py-2.5">
      <div className="flex items-center justify-between"><span className="text-[10.5px] font-semibold text-slate-700">{title}</span><Link href={href} className={cx("text-[9.5px]", records.length ? "text-emerald-600" : "text-slate-400")}>{status}</Link></div>
      {records.length > 0 && <div className="mt-1.5 truncate font-mono text-[9px] text-slate-400">{records.slice(0, 2).join("　")}</div>}
    </div>
  );
}

function ProfileMetric({ icon, label, value }: { icon: IconName; label: string; value: string }) {
  return (
    <div className="flex min-w-0 items-center gap-2">
      <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-500"><Icon name={icon} size={13} /></span>
      <span className="min-w-0"><span className="block truncate text-[8.5px] text-slate-400">{label}</span><span className="mt-0.5 block truncate text-[10px] font-semibold text-slate-700">{value}</span></span>
    </div>
  );
}

function SupplierList({ suppliers, loading, query, selectedName, onQueryChange, onSelect }: {
  suppliers: WorkbenchSupplierSummary[]; loading: boolean; query: string; selectedName: string | null;
  onQueryChange: (value: string) => void; onSelect: (name: string) => void;
}) {
  return (
    <section className="min-w-0 overflow-x-auto rounded-xl border border-slate-200/90 bg-white shadow-[0_3px_14px_rgba(40,53,85,0.035)]">
      <div className="flex min-w-[700px] items-center justify-between gap-3 border-b border-slate-100 px-4 py-3">
        <div><h2 className="text-[13px] font-semibold text-slate-800">供应商管理</h2><p className="mt-0.5 text-[10px] text-slate-400">采购频次、金额、入库与发票状态汇总</p></div>
        <div className="flex w-56 items-center gap-2 rounded-lg bg-slate-50 px-3"><Icon name="search" size={14} /><input value={query} onChange={(event) => onQueryChange(event.target.value)} placeholder="搜索供应商" className="h-8 min-w-0 flex-1 bg-transparent text-[11px] outline-none placeholder:text-slate-400" /></div>
      </div>
      <div className="grid min-w-[700px] grid-cols-[minmax(220px,1fr)_90px_130px_110px_110px] gap-3 border-b border-slate-100 bg-slate-50/70 px-4 py-2 text-[10px] font-medium text-slate-400">
        <span>供应商</span><span className="text-right">采购次数</span><span className="text-right">累计采购</span><span className="text-right">未入库</span><span className="text-right">最近采购</span>
      </div>
      {loading ? <Loading text="正在加载供应商…" /> : suppliers.length === 0 ? <Empty text="暂无供应商数据" /> : <div className="min-w-[700px] divide-y divide-slate-100">{suppliers.map((supplier) => (
        <button key={supplier.supplierName} onClick={() => onSelect(supplier.supplierName)} className={cx(
          "grid w-full grid-cols-[minmax(220px,1fr)_90px_130px_110px_110px] items-center gap-3 px-4 py-3 text-left transition-colors",
          selectedName === supplier.supplierName ? "bg-indigo-50/60 ring-1 ring-inset ring-indigo-400" : "hover:bg-slate-50"
        )}>
          <span className="truncate text-[12px] font-medium text-slate-700">{supplier.supplierName}</span>
          <span className="text-right text-[11px] tabular-nums text-slate-500">{supplier.orderCount}次</span>
          <span className="text-right text-[11px] font-semibold tabular-nums text-slate-700">{fmtMoney(supplier.totalPurchase)}</span>
          <span className="text-right text-[11px] tabular-nums text-orange-500">{fmtMoney(supplier.uninbound)}</span>
          <span className="text-right text-[10px] text-slate-400">{fmtDate(supplier.lastOrderDate)}</span>
        </button>
      ))}</div>}
    </section>
  );
}

function SupplierDetailPanel({ detail, loading }: { detail: WorkbenchSupplierDetail | null; loading: boolean }) {
  if (loading && !detail) return <aside className="rounded-xl border border-slate-200 bg-white"><Loading text="正在加载供应商画像…" /></aside>;
  if (!detail) return <aside className="flex min-h-[480px] items-center justify-center rounded-xl border border-slate-200 bg-white text-[12px] text-slate-400">选择供应商查看详情</aside>;
  return (
    <aside className="xl:sticky xl:top-5 xl:self-start">
      <div className="rounded-xl border border-slate-200/90 bg-white p-4 shadow-[0_4px_18px_rgba(40,53,85,0.04)]">
        <div className="text-[9px] text-slate-400">供应商画像</div><h2 className="mt-1 text-[15px] font-semibold text-slate-800">{detail.supplierName}</h2>
        <div className="mt-4 grid grid-cols-2 gap-2">
          <SupplierMetric label="采购次数" value={detail.orderCount + "次"} tone="indigo" />
          <SupplierMetric label="累计采购" value={fmtMoney(detail.totalPurchase)} tone="indigo" />
          <SupplierMetric label="未开票金额" value={fmtMoney(detail.uninvoiced)} tone="amber" />
          <SupplierMetric label="未入库金额" value={fmtMoney(detail.uninbound)} tone="amber" />
        </div>
        <div className="mt-3 rounded-lg border border-slate-100 p-3">
          <div className="text-[10.5px] font-semibold text-slate-700">常购SKU</div>
          <div className="mt-2 space-y-1.5">{detail.oftenSkus.length > 0 ? detail.oftenSkus.slice(0, 6).map((sku) => (
            <div key={sku.skuCode} className="flex items-center justify-between gap-2 rounded-md bg-slate-50 px-2.5 py-2 text-[9.5px]"><span className="truncate text-slate-600">{sku.goodsName || "未命名商品"}</span><span className="shrink-0 font-mono text-indigo-500">{sku.skuCode} · {sku.count}次</span></div>
          )) : <div className="py-4 text-center text-[10px] text-slate-400">暂无常购SKU</div>}</div>
        </div>
        <div className="mt-3 rounded-lg border border-slate-100 p-3">
          <div className="text-[10.5px] font-semibold text-slate-700">最近采购订单</div>
          <div className="mt-2 space-y-1.5">{detail.recentOrders.length > 0 ? detail.recentOrders.slice(0, 6).map((order) => (
            <div key={order.orderId} className="flex items-center justify-between gap-2 rounded-md bg-slate-50 px-2.5 py-2 text-[9.5px]"><span className="truncate font-mono text-indigo-500">{order.orderNo}</span><span className="shrink-0 text-slate-400">{fmtDate(order.orderDate)}　{fmtMoney(order.amount)}</span></div>
          )) : <div className="py-4 text-center text-[10px] text-slate-400">暂无历史订单</div>}</div>
        </div>
      </div>
    </aside>
  );
}

function SupplierMetric({ label, value, tone }: { label: string; value: string; tone: "indigo" | "amber" }) {
  return <div className={cx("rounded-lg px-3 py-2.5", tone === "indigo" ? "bg-indigo-50/60" : "bg-amber-50/60")}><div className="text-[9px] text-slate-400">{label}</div><div className={cx("mt-1 text-[12px] font-semibold tabular-nums", tone === "indigo" ? "text-indigo-700" : "text-amber-700")}>{value}</div></div>;
}

function Loading({ text }: { text: string }) {
  return <div className="flex min-h-[160px] items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white text-[11px] text-slate-400"><span className="h-4 w-4 animate-spin rounded-full border-2 border-slate-200 border-t-indigo-500" />{text}</div>;
}

function Empty({ text }: { text: string }) {
  return <div className="flex min-h-[160px] items-center justify-center rounded-xl border border-slate-200 bg-white text-[11px] text-slate-400">{text}</div>;
}

